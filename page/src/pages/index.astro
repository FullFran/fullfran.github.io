---
import '../styles/global.css';
import '../styles/premium.css';
import App from '../components/App';
import { getCollection } from 'astro:content';
import { links, name, site } from '../data/site';
import { cardAlt, ogImage, OG_HEIGHT, OG_WIDTH } from '../lib/og/card';

const posts = (await getCollection('blog'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    date: entry.data.date.toISOString(),
    lang: entry.data.lang,
    description: entry.data.description ?? '',
  }));

const image = new URL(ogImage.home, Astro.site).href;
const imageAlt = cardAlt({ kind: 'home', name, tagline: site.es.tagline });

const description =
  'Físico que construye sistemas de IA. Escribo sobre IA y física: atascos, gatos que caen, imanes con memoria y máquinas que demuestran teoremas.';

// Who this site is about, for search engines and the assistants that read them.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.fullfran.com/#person',
      name,
      alternateName: 'FullFran',
      url: 'https://www.fullfran.com/',
      jobTitle: 'Físico e ingeniero de IA',
      sameAs: links.filter((l) => l.href.startsWith('https://')).map((l) => l.href),
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.fullfran.com/#website',
      url: 'https://www.fullfran.com/',
      name,
      inLanguage: 'es',
      author: { '@id': 'https://www.fullfran.com/#person' },
    },
    {
      '@type': 'Blog',
      url: 'https://www.fullfran.com/blog/',
      name: `${name} — Blog`,
      inLanguage: 'es',
      author: { '@id': 'https://www.fullfran.com/#person' },
      blogPost: posts.slice(0, 10).map((p) => ({
        '@type': 'BlogPosting',
        headline: p.title,
        url: `https://www.fullfran.com/blog/${p.slug}/`,
        datePublished: p.date,
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href="https://www.fullfran.com/" />
		<link rel="alternate" type="application/rss+xml" title={`${name} · Blog`} href="/rss.xml" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Francisco Olmedo" />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={name} />
		<meta property="og:url" content="https://www.fullfran.com/" />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(OG_WIDTH)} />
		<meta property="og:image:height" content={String(OG_HEIGHT)} />
		<meta property="og:image:alt" content={imageAlt} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Francisco Olmedo" />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<title>Francisco Olmedo — Físico. Construyo sistemas de IA.</title>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<App client:load posts={posts} />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
	}

	html, body {
		margin: 0;
		padding: 0;
		background: #0a0a0f;
	}

	/* Visible keyboard focus, without touching mouse users. */
	:focus-visible {
		outline: 2px solid #7dcfff;
		outline-offset: 3px;
		border-radius: 3px;
	}

	.skip-link {
		position: absolute;
		left: 1rem;
		top: -4rem;
		z-index: 100;
		padding: 0.6rem 1rem;
		background: #7aa2f7;
		color: #0a0a0f;
		font-weight: 600;
		border-radius: 0 0 8px 8px;
		text-decoration: none;
		transition: top 0.15s;
	}

	.skip-link:focus {
		top: 0;
	}

	/* The background gradients pulse forever; give people a way out. */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
