---
import '../styles/global.css';
import '../styles/premium.css';
import App from '../components/App';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    date: entry.data.date.toISOString(),
    lang: entry.data.lang,
    description: entry.data.description ?? '',
    body: entry.body ?? '',
  }));
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Physicist building production AI. Notes on AI, physics and keyboards." />
		<meta name="keywords" content="AI, Machine Learning, Physics, Physicist, LLMs, RAG, keyboards" />
		<link rel="alternate" type="application/rss+xml" title="Francisco Olmedo — Writing" href="/rss.xml" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Francisco Olmedo" />
		<meta property="og:description" content="Physicist building production AI. Notes on AI, physics and keyboards." />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Francisco Olmedo" />
		<meta name="twitter:description" content="Physicist building production AI. Notes on AI, physics and keyboards." />

		<title>Francisco Olmedo — Physicist. I build AI systems that ship.</title>
	</head>
	<body>
		<App client:only="react" posts={posts} />
	</body>
</html>

<style is:global>
	html, body {
		margin: 0;
		padding: 0;
		background: #0a0a0f;
	}
</style>
